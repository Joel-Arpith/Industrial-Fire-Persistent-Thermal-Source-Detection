# =====================================================================
# Industrial Fire & Persistent Thermal Source Detection
# Environment Variables Configuration
# =====================================================================

# NASA FIRMS API Map Key (Free signup at https://firms.modaps.eosdis.nasa.gov/api/area/)
FIRMS_MAP_KEY=your_nasa_firms_map_key_here

# SQLite Database storage location
DB_PATH=data/hotspots.db

# Default Bounding Box for Industrial Monitoring (West, South, East, North)
# Default: Gujarat/Maharashtra Industrial Belt (Hazira/Surat/Dahej)
DEMO_BBOX_WEST=72.5
DEMO_BBOX_SOUTH=21.0
DEMO_BBOX_EAST=73.5
DEMO_BBOX_NORTH=22.0

# Overpass API endpoint and local cache path
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_CACHE_PATH=data/osm_cache.json

# API Server configuration
API_HOST=0.0.0.0
API_PORT=8000
